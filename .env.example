# See CONFIGURATION.md for the full reference, including which of these are
# also overridable at runtime via /admin.

# Twilio core
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx  # required for webhook signature validation only
TWILIO_PHONE_NUMBER=+1234567890

# Twilio API Key (used for all SDK calls)
TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Twilio Sync service (create in Console > Develop > Sync > Services)
TWILIO_SYNC_SERVICE_SID=ISxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Twilio Conversation Intelligence (create config in Console > Voice > Conversation Intelligence)
TWILIO_CONVERSATION_CONFIGURATION_ID=conv_configuration_xxxxxxxxxx
TWILIO_TAC_CI_CONFIGURATION_ID=intelligence_configuration_xxxxxxxxxx

# Call routing
# For testing: a regular E.164 phone number (+14155551234)
# For production at events: a SIP URI (sip:booth@your-pbx.example.com)
SIP_PHONE_ADDRESS=+1234567890

# Let visitors type a phone number/SIP address on the start page instead of
# always calling SIP_PHONE_ADDRESS. Leave unset/false for events where the
# booth always calls the same fixed line.
# Overridable at runtime via /admin (see below) — these are just the defaults.
# ALLOW_PHONE_NUMBER_OVERRIDE=true

# Order fulfillment backend (required — order submission has no fallback without these)
MIXOLOGIST_BASE_URL=https://your-mixologist.example.com
MIXOLOGIST_AUTH=user:password

# Drink type: "coffee" (default), "smoothie", or "drinks" (cocktails)
# Overridable at runtime via /admin — this is just the default.
DRINK_TYPE=smoothie

# Event name sent in order payloads (default: booth)
# Overridable at runtime via /admin — this is just the default.
EVENT_NAME=booth

# Human-readable event name used in the agent's welcome greeting and system prompt.
# If unset, no event name is mentioned.
# Overridable at runtime via /admin — this is just the default.
# EVENT_DISPLAY_NAME=WeAreDevelopers World Congress

# Comma-separated menu items; names with descriptions use Name(ingredients) syntax.
# Coffee default: Espresso,Cortado,Cappuccino,Flat White,Americano,Matcha Latte,Cold Brew,Iced Matcha,Iced Latte
# Smoothie example:
# Overridable at runtime via /admin — this is just the default.
MENU_ITEMS=Macarena(Strawberry, Pineapple, Apple, Passion Fruit, Goji, Vanilla),La Isla Bonita(Pineapple, Banana, Coconut Milk, Dates, Blue Spirulina),Calma(Mango, Pineapple, Spinach, Banana, Almonds, Ginger, Lemon)

# Public base URL for Twilio webhooks
# Local dev: your ngrok HTTPS URL (e.g. https://abc123.ngrok.io)
# Production: your deployed service URL (e.g. https://tac-voice.example.com)
NGROK_BASE_URL=https://your-tunnel.ngrok.io

# Stats dashboard basic auth
STATS_USER=admin
STATS_PASS=changeme

# OpenAI
OPENAI_API_KEY=sk-...

# Twilio Knowledge Base (optional — lets the agent search custom knowledge, see CONFIGURATION.md)
# TWILIO_TAC_KNOWLEDGE_BASE_ID=know_knowledgebase_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Attract mode — idle popup that invites passers-by to pick up the phone
# Overridable at runtime via /admin — this is just the default.
# ATTRACT_MODE=true        # enable random 5-10 min idle popups
# ATTRACT_DEV=true         # dev shortcut: fire once after 20 s (overrides ATTRACT_MODE timing)

# Admin config page — reuses STATS_USER/STATS_PASS for basic auth.
# Visit /admin to override ATTRACT_MODE, ALLOW_PHONE_NUMBER_OVERRIDE, DRINK_TYPE,
# EVENT_NAME, EVENT_DISPLAY_NAME, and MENU_ITEMS at runtime without editing this
# file. Overrides are stored in a Twilio Sync Document and take effect after the
# server restarts itself to apply them.
